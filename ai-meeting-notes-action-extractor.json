      ],
      "id": "36b78560-1636-4694-90a1-c5d4bcf702b0",
      "name": "Prepare Transcript"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an AI meeting notes assistant.\n\nAnalyze the meeting transcript below.\n\nWrite ONLY a concise meeting summary in 1–2 short paragraphs.\n\nDo NOT include:\n- KEY DECISIONS\n- ACTION ITEMS\n- RISKS / BLOCKERS\n- headings\n- labels\n- explanations\n\nUse only information explicitly supported by the transcript.\n\nMEETING TRANSCRIPT:\n\n{{ $json.transcript }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        -144,
        -160
      ],
      "id": "b6f15421-410f-4dcb-8c20-f8594d4a26e6",
      "name": "Generate Meeting Summary"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "bdb92e02-e9d6-4b72-88b5-d6a15e2a6aab",
              "name": "=meeting_notes",
              "value": "={{ $json.content.parts[0].text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        160,
        -112
      ],
      "id": "a76f177c-10b7-49e0-9a7d-e107631e342b",
      "name": "Prepare AI Output"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an AI meeting action-item extractor.\n\nAnalyze the ORIGINAL MEETING TRANSCRIPT below.\n\nReturn ONLY these two sections:\n\nKEY DECISIONS\n- List each important decision explicitly made during the meeting.\n- If there are no key decisions, write:\nNone specified.\n\nACTION ITEMS\nFor EVERY action item mentioned in the transcript, preserve the exact task, owner, and deadline.\n\nUse this format:\n\n- Task: [task]\n- Owner: [person/team]\n- Deadline: [deadline]\n\nRules:\n1. Do not invent information.\n2. Do not combine separate action items.\n3. Do not assign an owner unless the transcript explicitly identifies one.\n4. If the owner is not mentioned, write \"Not specified\".\n5. If the deadline is not mentioned, write \"Not specified\".\n6. Keep each action item separate.\n7. Use only information explicitly supported by the transcript.\n8. Return ONLY KEY DECISIONS and ACTION ITEMS. Do not add explanations.\n\nORIGINAL MEETING TRANSCRIPT:\n{{ $('Prepare Transcript').item.json.transcript }}\n"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        368,
        -64
      ],
      "id": "5cb72418-8107-4fbd-a0a0-bd92eba3d7d7",
      "name": "Extract Decisions & Actions"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "23aa7d9f-b0a1-4e87-8e05-50f4fed36930",
              "name": "=key_decisions",
              "value": "={{ $('Extract Decisions & Actions').item.json.content.parts[0].text\n.split('ACTION ITEMS')[0]\n.replace('KEY DECISIONS', '')\n.replaceAll('\\\\n', '\\n')\n.trim() }}",
              "type": "string"
            },
            {
              "id": "910dbe8c-c199-41c1-a988-8015e5e324a6",
              "name": "=action_items",
              "value": "={{ $('Extract Decisions & Actions').item.json.content.parts[0].text\n.split('ACTION ITEMS')[1]\n.replaceAll('\\\\n', '\\n')\n.trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        448,
